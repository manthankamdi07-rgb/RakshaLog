# ==============================================================================
# RAKSHALOG GIS MAP API CONFIGURATION
# ==============================================================================
# Default active provider options:
# google-hybrid (Google Satellite + Road & Post Overlays - Recommended)
# google-satellite (Google Pure Satellite Reconnaissance)
# google-terrain (Google Topographic Elevation Contours)
# google-roadmap (Google Tactical Road Map)
# esri-dark (Free, No Key Needed, No Watermark)
# esri-satellite (Free, No Key Needed, Satellite Imagery)
# ==============================================================================

VITE_DEFAULT_MAP_PROVIDER=google-hybrid

# Google Maps API Key (Optional for basic tiles, recommended for full Google Maps JS SDK & geocoding)
# Get a key from: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# If using CARTO basemaps (https://carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=

# If using Mapbox (https://account.mapbox.com/)
VITE_MAPBOX_TOKEN=

# If using MapTiler (https://cloud.maptiler.com/)
VITE_MAPTILER_KEY=
